<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controllers.RosterController">

    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Current Roster"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label fx:id="pointsLabel"
                   text="0 / 0"
                   style="-fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true">

            <content>
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>

                    <!-- HQ -->
                    <VBox spacing="5">
                        <Label text="HQ"
                               style="-fx-font-weight: bold;"/>

                        <VBox fx:id="hqPanel"
                              spacing="3"/>
                    </VBox>

                    <!-- Elites -->
                    <VBox spacing="5">
                        <Label text="Elites"
                               style="-fx-font-weight: bold;"/>

                        <VBox fx:id="elitesPanel"
                              spacing="3"/>
                    </VBox>

                    <!-- Troops -->
                    <VBox spacing="5">
                        <Label text="Troops"
                               style="-fx-font-weight: bold;"/>

                        <VBox fx:id="troopsPanel"
                              spacing="3"/>
                    </VBox>

                    <!-- Fast Attack -->
                    <VBox spacing="5">
                        <Label text="Fast Attack"
                               style="-fx-font-weight: bold;"/>

                        <VBox fx:id="fastAttackPanel"
                              spacing="3"/>
                    </VBox>

                    <!-- Heavy Support -->
                    <VBox spacing="5">
                        <Label text="Heavy Support"
                               style="-fx-font-weight: bold;"/>

                        <VBox fx:id="heavySupportPanel"
                              spacing="3"/>
                    </VBox>

                    <!-- Other -->
                    <VBox spacing="5">
                        <Label text="Other"
                               style="-fx-font-weight: bold;"/>

                        <VBox fx:id="nonePanel"
                              spacing="3"/>
                    </VBox>

                </VBox>
            </content>

        </ScrollPane>
    </center>

</BorderPane>