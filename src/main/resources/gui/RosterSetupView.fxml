<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.controllers.RosterSetupController"
      alignment="CENTER"
      spacing="20">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Fourth Ed Army Builder"
           styleClass="title-label"/>

    <GridPane hgap="10" vgap="15">

        <Label text="Roster Name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="nameField"
                   promptText="Enter roster name"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Points Limit:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <Spinner fx:id="pointsSpinner"
                 editable="true"
                 GridPane.columnIndex="1"
                 GridPane.rowIndex="1"/>

        <Label text="Force Organization:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <ComboBox fx:id="forceOrgComboBox"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="2"/>

    </GridPane>

    <Button fx:id="createButton"
            text="Create Roster"
            onAction="#createRoster"/>

</VBox>